# ClassLink AI Service Configuration

# === API Keys ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Model Configuration ===
# Default model for most queries
GEMINI_MODEL=gemini-2.5-flash
# Pro model for complex reasoning (optional, falls back to default)
GEMINI_MODEL_PRO=gemini-2.5-pro

# === Service Configuration ===
# AI Service port (default: 12346)
AI_SERVICE_PORT=12346
# Maximum concurrent AI requests (default: 6)
MAX_CONCURRENT=6

# === MQTT Configuration ===
# MQTT broker address (Raspberry Pi IP)
MQTT_HOST=192.168.4.1
MQTT_PORT=1883

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
